DATABASE_URL="file:./dev.db"
DATA_SOURCE="prisma"

# Storage Provider Configuration
# Supported in local development: LOCAL_PRIVATE
# Supported in production: SUPABASE, S3, GCS, AZURE_BLOB
STORAGE_PROVIDER="LOCAL_PRIVATE"

# ==============================================================================
# Supabase Persistent Cloud Storage (Production Document Management)
# ==============================================================================
# Note: Never commit real credentials to source control.
# Supabase Project Settings -> API:
SUPABASE_URL="https://your-project-id.supabase.co"
# Supabase Project Settings -> API -> Project API keys -> service_role (secret)
# CRITICAL: Keep server-side only. Never expose to client bundles or NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
# Supabase Storage -> Create Bucket -> Name: "student-documents", Public: FALSE (strictly private)
SUPABASE_STORAGE_BUCKET="student-documents"

# ==============================================================================
# Alternative Cloud Storage Providers (Optional)
# ==============================================================================
# S3_BUCKET=""
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""
#
# GCS_BUCKET=""
# GCS_API_KEY=""
#
# AZURE_STORAGE_ACCOUNT=""
# AZURE_STORAGE_CONTAINER=""
# AZURE_STORAGE_SAS_TOKEN=""
